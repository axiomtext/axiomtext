---
const links = [
  { href: '/start/introduction/', label: 'Docs', cls: 'nav-docs' },
  { href: '/demo/', label: 'Demo' },
  { href: '/playground/', label: 'Playground' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="AxiomText home">
      <img src="/favicon.svg" width="28" height="28" alt="" />
      <span>AxiomText</span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} class={l.cls}>{l.label}</a>)}
      <a href="https://github.com/axiomtext/axiomtext" class="nav-github">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path></svg
        >
        <span>GitHub</span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
        >
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path></g
          ></svg
        >
      </button>
    </nav>
  </div>
</header>

<script>
  // Shares the docs' theme setting (Starlight stores it as "starlight-theme").
  const KEY = 'starlight-theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = () =>
    button?.setAttribute(
      'aria-label',
      root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  label();
  // A hairline under the header once the page scrolls.
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  button?.addEventListener('click', () => {
    // The new theme wipes outwards from the button.
    const r = button.getBoundingClientRect();
    root.style.setProperty('--wipe-x', `${r.left + r.width / 2}px`);
    root.style.setProperty('--wipe-y', `${r.top + r.height / 2}px`);
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage unavailable */
      }
      label();
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches)
      doc.startViewTransition(apply);
    else apply();
  });
</script>
