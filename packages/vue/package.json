{
  "name": "@axiomtext/vue",
  "version": "0.1.1",
  "description": "The AxiomText rich text and math editor as a Vue 3 component with v-model.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/vue"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "axiomtext": "workspace:*",
    "vue": "^3.5.46"
  },
  "peerDependencies": {
    "axiomtext": "workspace:^",
    "vue": "^3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
