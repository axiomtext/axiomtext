{
  "name": "@axiomtext/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Toolbar, dropdowns, status bar, themes and content styles for AxiomText. Internal: published as part of the axiomtext package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/axiomtext.css",
    "./content.css": "./styles/content.css",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomtext/core": "workspace:*",
    "@axiomtext/i18n": "workspace:*",
    "@axiomtext/view": "workspace:*",
    "lucide": "^1.78.0",
    "@axiomtext/plugin-comments": "workspace:*",
    "@axiomtext/viewer": "workspace:*",
    "@axiomtext/plugin-marks": "workspace:*"
  },
  "devDependencies": {
    "@axiomtext/plugin-basic-styles": "workspace:*",
    "@axiomtext/plugin-heading": "workspace:*",
    "@axiomtext/plugin-block-format": "workspace:*",
    "@axiomtext/plugin-font": "workspace:*",
    "@axiomtext/plugin-table": "workspace:*",
    "@axiomtext/plugin-image": "workspace:*"
  }
}
