{
  "name": "@axiomtext/ui",
  "version": "0.0.0",
  "description": "Toolbar, dropdowns, status bar, themes and content styles for AxiomText.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/axiomtext.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomtext/view": "workspace:*",
    "lucide": "^1.77.0"
  },
  "devDependencies": {
    "@axiomtext/core": "workspace:*",
    "@axiomtext/plugin-basic-styles": "workspace:*",
    "@axiomtext/plugin-heading": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
