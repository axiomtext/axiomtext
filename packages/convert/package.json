{
  "name": "@axiomtext/convert",
  "version": "0.1.0",
  "private": true,
  "description": "HTML, Markdown, DOCX and PDF conversion (client-side). Internal: published as part of the axiomtext package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/convert"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bijoy": {
      "types": "./dist/bijoy.d.ts",
      "import": "./dist/bijoy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "@axiomtext/core": "workspace:*"
  },
  "devDependencies": {
    "@axiomtext/math": "workspace:*",
    "@axiomtext/plugin-basic-styles": "workspace:*",
    "@axiomtext/plugin-blockquote": "workspace:*",
    "@axiomtext/plugin-columns": "workspace:*",
    "@axiomtext/plugin-font": "workspace:*",
    "@axiomtext/plugin-heading": "workspace:*",
    "@axiomtext/plugin-image": "workspace:*",
    "@axiomtext/plugin-link": "workspace:*",
    "@axiomtext/plugin-list": "workspace:*",
    "@axiomtext/plugin-table": "workspace:*",
    "@axiomtext/view": "workspace:*",
    "@types/markdown-it": "^14.2.0"
  }
}
