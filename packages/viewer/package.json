{
  "name": "@axiomtext/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Shows saved AxiomText content: comment threads on click, and readers' own highlights and notes. Internal: published as axiomtext/viewer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/viewer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./picker": {
      "types": "./dist/picker.d.ts",
      "import": "./dist/picker.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "import": "./dist/anchor.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomtext/i18n": "workspace:*",
    "@axiomtext/plugin-comments": "workspace:*",
    "@axiomtext/plugin-marks": "workspace:*"
  }
}
