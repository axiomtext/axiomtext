{
  "name": "@axiomtext/presets",
  "version": "0.1.0",
  "description": "Ready-made AxiomText editors (classic, inline, balloon) with every free feature, plus CDN builds.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/presets"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cdn/*": "./dist/cdn/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/cdn-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomtext/core": "workspace:*",
    "@axiomtext/view": "workspace:*",
    "@axiomtext/ui": "workspace:*",
    "@axiomtext/math": "workspace:*",
    "@axiomtext/convert": "workspace:*",
    "@axiomtext/plugin-basic-styles": "workspace:*",
    "@axiomtext/plugin-block-format": "workspace:*",
    "@axiomtext/plugin-blockquote": "workspace:*",
    "@axiomtext/plugin-columns": "workspace:*",
    "@axiomtext/plugin-font": "workspace:*",
    "@axiomtext/plugin-heading": "workspace:*",
    "@axiomtext/plugin-image": "workspace:*",
    "@axiomtext/plugin-link": "workspace:*",
    "@axiomtext/plugin-list": "workspace:*",
    "@axiomtext/plugin-table": "workspace:*",
    "katex": "^0.19.1"
  },
  "jsdelivr": "dist/cdn/axiomtext.iife.js",
  "unpkg": "dist/cdn/axiomtext.iife.js"
}
