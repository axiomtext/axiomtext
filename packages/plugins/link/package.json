{
  "name": "@axiomtext/plugin-link",
  "version": "0.0.0",
  "description": "Links with safe URLs and automatic linking.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/plugins/link"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@axiomtext/core": "workspace:*",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.7.0",
    "prosemirror-transform": "^1.10.0"
  },
  "devDependencies": {
    "@axiomtext/view": "workspace:*",
    "@axiomtext/test-utils": "workspace:*"
  }
}
