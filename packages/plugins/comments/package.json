{
  "name": "@axiomtext/plugin-comments",
  "version": "0.1.0",
  "private": true,
  "description": "Comment threads on text: highlight, discuss, resolve. Internal: published as part of the axiomtext package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/plugins/comments"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomtext/core": "workspace:*",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.43.0"
  },
  "devDependencies": {
    "@axiomtext/view": "workspace:*",
    "@axiomtext/test-utils": "workspace:*"
  }
}
