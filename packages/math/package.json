{
  "name": "@axiomtext/math",
  "version": "0.1.0",
  "private": true,
  "description": "Math equation editor for AxiomText: inline and block equations with LaTeX, live preview and KaTeX rendering. Internal: published as part of the axiomtext package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://axiomtext.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomtext/axiomtext.git",
    "directory": "packages/math"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomtext/core": "workspace:*",
    "@axiomtext/i18n": "workspace:*",
    "katex": "^0.19.1",
    "mathlive": "^0.111.4",
    "prosemirror-inputrules": "^1.7.0",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.43.1"
  },
  "devDependencies": {
    "@axiomtext/test-utils": "workspace:*"
  }
}
