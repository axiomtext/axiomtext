[
  {
    "name": "@axiomtext/core",
    "path": "packages/core/dist/index.js",
    "limit": "40 KB",
    "gzip": true
  },
  {
    "name": "@axiomtext/view (core + view incl. ProseMirror engine)",
    "path": "packages/view/dist/index.js",
    "import": "{ createEditor }",
    "limit": "70 KB",
    "gzip": true
  },
  {
    "name": "@axiomtext/ui (classic editor: engine + full toolbar UI, excl. feature plugins)",
    "path": "packages/ui/dist/index.js",
    "import": "{ createClassicEditor }",
    "limit": "85 KB",
    "gzip": true
  },
  {
    "name": "@axiomtext/math (plugin incl. MathML paste + lazy LaTeX autocomplete; KaTeX and MathLive load on demand)",
    "path": "packages/math/dist/index.js",
    "import": "{ MathPlugin }",
    "ignore": [
      "katex",
      "prosemirror-model",
      "prosemirror-state",
      "prosemirror-view",
      "prosemirror-inputrules",
      "prosemirror-transform",
      "@axiomtext/core",
      "mathlive"
    ],
    "limit": "14 KB",
    "gzip": true
  }
]
