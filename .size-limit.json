[
  {
    "name": "@axiomtext/core",
    "path": "packages/core/dist/index.js",
    "limit": "40 KB",
    "gzip": true
  },
  {
    "name": "@axiomtext/view (core + view incl. ProseMirror engine)",
    "path": "packages/view/dist/index.js",
    "import": "{ createEditor }",
    "limit": "70 KB",
    "gzip": true
  },
  {
    "name": "@axiomtext/ui (classic editor: core + view + toolbar, excl. plugins)",
    "path": "packages/ui/dist/index.js",
    "import": "{ createClassicEditor }",
    "limit": "75 KB",
    "gzip": true
  },
  {
    "name": "@axiomtext/math (plugin only \u2014 KaTeX is lazy-loaded when a document has math)",
    "path": "packages/math/dist/index.js",
    "import": "{ MathPlugin }",
    "ignore": [
      "katex",
      "prosemirror-model",
      "prosemirror-state",
      "prosemirror-view",
      "prosemirror-inputrules",
      "prosemirror-transform",
      "@axiomtext/core"
    ],
    "limit": "10 KB",
    "gzip": true
  }
]
